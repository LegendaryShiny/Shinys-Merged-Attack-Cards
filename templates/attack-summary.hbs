{{!-- Targets --}}
{{#if targets.length}}
<section class="icon-row">
    <i class="fa-fw fa-solid fa-bullseye" aria-label="{{ localize "DND5E.CHATMESSAGE.Row.Targets" }}"></i>
    <ul class="unlist targets pills">
        {{#each targets}}
        <li>
            <target-pill {{#if showResult}}{{ ifThen isMiss "data-miss" "data-hit" }}{{/if}}
                {{#if showAC}}data-value="{{ ifThen hasAC ac "∞" }}"{{/if}}>
                <label>{{ name }}</label>
                <datalist>
                    <option value="{{ token }}">{{ name }}</option>
                </datalist>
            </target-pill>
        </li>
        {{/each}}
    </ul>
</section>
{{/if}}

{{!-- Rolls --}}
{{> "dnd5e.card-rolls" }}
