{{!-- Targets --}}
{{#if targets.length}}
<section class="icon-row">
    <i class="fa-fw fa-solid fa-bullseye" aria-label="{{ localize "DND5E.CHATMESSAGE.Row.Targets" }}"></i>
    <ul class="unlist targets pills">
        {{#each targets}}
        <li>
            <target-pill {{#if showResult}}{{ ifThen isMiss "data-miss" "data-hit" }}{{/if}}
                {{#if showAC}}data-value="{{ ifThen hasAC ac "∞" }}"{{/if}}>
                <label>{{ name }}</label>
                <datalist>
                    <option value="{{ token }}">{{ name }}</option>
                </datalist>
            </target-pill>
        </li>
        {{/each}}
    </ul>
</section>
{{/if}}

{{!-- Rolls --}}
<div class="smac smac-attack">
    <h4 class="smac-heading">{{ smacHeading }}</h4>
    {{#each attacks}}
    <div class="smac-entry">
        <div class="smac-formula">{{#if isPrivate}}???{{else}}{{ formula }}{{/if}}</div>
        <button type="button" class="smac-result {{ classes }}" {{ disabled isPrivate }}>
            {{#unless isPrivate}}
            {{#if icons.length}}
            <span class="smac-icons">
                {{#each icons}}<i class="fa-solid {{ this }}" inert></i>{{/each}}
            </span>
            {{/if}}
            {{/unless}}
            <span class="smac-total">{{ ifThen isPrivate "?" total }}</span>
            <i class="fa-solid fa-chevron-right smac-chevron" inert></i>
        </button>
        {{#unless isPrivate}}<div class="roll-breakdown" popover>{{{ tooltip }}}</div>{{/unless}}
    </div>
    {{/each}}
</div>
